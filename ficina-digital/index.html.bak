<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTech Soluções Tecnológicas</title>
    <script>tailwind={config:{corePlugins:{preflight:false}}}</script>
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <style type="text/tailwindcss">
.t-card{@apply rounded-xl border border-slate-200 bg-white p-5 shadow-sm}
.t-in{@apply w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-sky-400}
.t-lbl{@apply mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500}
.t-b2{@apply rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer}
.t-tab{@apply rounded-full px-4 py-1.5 text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 cursor-pointer}
.t-tab.on{@apply bg-sky-700 text-white}
</style>
<style>@media print{header,footer,.no-print{display:none!important}.container{box-shadow:none;margin:0;max-width:100%}}</style>

    <style>
        :root {
            --primary: #0B3C5D;
            --secondary: #328CC1;
            --bg: #F4F7F6;
            --text: #1D2731;
            --open: #28A745;
            --in-progress: #FFC107;
            --closed: #DC3545;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: var(--primary);
            color: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        header h1 {
            font-size: 1.5rem;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 1.5rem;
            font-weight: 600;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #D9B310;
        }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 2rem;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            flex: 1;
        }

        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        h2 {
            color: var(--primary);
            margin-bottom: 1.5rem;
            border-bottom: 2px solid var(--secondary);
            padding-bottom: 0.5rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 1rem;
        }

        .btn {
            background-color: var(--secondary);
            color: white;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn:hover {
            background-color: var(--primary);
        }

        .badge {
            padding: 0.4rem 0.8rem;
            color: white;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.85rem;
            display: inline-block;
        }

        .status-aberto { background-color: var(--open); }
        .status-atendimento { background-color: var(--in-progress); color: #333; }
        .status-encerrado { background-color: var(--closed); }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }

        table th, table td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
        }

        table th {
            background-color: #f8f9fa;
            color: var(--primary);
        }

        footer {
            background-color: var(--primary);
            color: white;
            text-align: center;
            padding: 1rem;
            margin-top: auto;
        }
    </style>
</head>
<body>

    <header>
        <h1>Gtech Soluções Tecnológicas</h1>
        <nav>
            <a href="#home" target="_self" onclick="showPage('home')">Início</a>
            <a href="#contratar" target="_self" onclick="showPage('contratar')">Contratar Serviço</a>
            <a href="#proposta" target="_self" onclick="showPage('proposta')">Proposta de Vendas</a>
            <a href="#painel" target="_self" onclick="showPage('painel')">Painel &amp; Documentos</a>
            <a href="#login" target="_self" onclick="showPage('login')">Área Restrita (Helpdesk N1)</a>
        </nav>
    </header>

    <div class="container">
        
        <!-- HOME PAGE -->
        <div id="home" class="page active">
            <h2>Bem-vindo à GTech Soluções</h2>
            <p style="margin-bottom: 1rem;">Oferecemos serviços de suporte técnico remoto de alta performance com AnyDesk, TeamViewer e parque de máquinas contingencial para garantir que sua empresa nunca pare.</p>
            <button class="btn" onclick="showPage('contratar')">Contratar Serviço / Abrir Demanda</button>
            <button class="btn" style="background:#0B3C5D" onclick="showPage('proposta')">Montar Proposta de Vendas</button>
            <button class="btn" style="background:#6c757d" onclick="showPage('painel')">Painel &amp; Documentos</button>
        </div>

        <!-- PROPOSTA DE VENDAS -->
        <div id="proposta" class="page">
            <div class="flex flex-wrap items-end justify-between gap-3 mb-6">
                <div>
                    <h2 style="margin:0;border:0;padding:0">Proposta de Prestação de Serviço</h2>
                    <p class="text-sm text-slate-500 mt-1">Selecione cliente, vendedor e serviços — os valores são calculados automaticamente.</p>
                </div>
                <div class="flex gap-2 no-print">
                    <button class="t-b2" onclick="PR.novo()">+ Nova proposta</button>
                    <button class="t-b2" onclick="PR.cad('cliente')">+ Cliente</button>
                    <button class="t-b2" onclick="PR.cad('servico')">+ Serviço</button>
                    <button class="t-b2" onclick="PR.cad('tecnico')">+ Vendedor</button>
                </div>
            </div>
            <div class="grid gap-5 lg:grid-cols-3">
                <div class="lg:col-span-2 space-y-5">
                    <section class="t-card">
                        <h3 class="mb-3 text-sm font-bold text-sky-900">1 · Cliente</h3>
                        <select id="pr-cli" class="t-in" onchange="PR.set('cli',this.value)"></select>
                        <div id="pr-cliinfo" class="mt-4 grid gap-3 text-sm sm:grid-cols-2"></div>
                    </section>
                    <section class="t-card">
                        <h3 class="mb-3 text-sm font-bold text-sky-900">2 · Vendedor / Técnico responsável e dados</h3>
                        <div class="grid gap-3 sm:grid-cols-3">
                            <div><label class="t-lbl">Vendedor</label><select id="pr-tec" class="t-in" onchange="PR.set('tec',this.value)"></select></div>
                            <div><label class="t-lbl">Nº da proposta</label><input id="pr-num" class="t-in" oninput="PR.set('num',this.value,1)"></div>
                            <div><label class="t-lbl">Data</label><input id="pr-data" type="date" class="t-in" oninput="PR.set('data',this.value,1)"></div>
                        </div>
                    </section>
                    <section class="t-card">
                        <div class="mb-3 flex items-center justify-between">
                            <h3 class="text-sm font-bold text-sky-900">3 · Serviços</h3>
                            <button class="t-b2 no-print" onclick="PR.add()">+ Adicionar serviço</button>
                        </div>
                        <div class="overflow-x-auto"><table class="min-w-[560px]">
                            <thead><tr><th>Serviço</th><th class="w-24">Quant.</th><th>Unid.</th><th class="text-right">Unitário</th><th class="text-right">Total</th><th></th></tr></thead>
                            <tbody id="pr-itens"></tbody>
                        </table></div>
                        <div class="mt-4"><label class="t-lbl">Observações</label><textarea id="pr-obs" rows="2" class="t-in" oninput="PR.set('obs',this.value,1)"></textarea></div>
                    </section>
                </div>
                <aside class="space-y-5">
                    <section class="t-card lg:sticky lg:top-4">
                        <h3 class="mb-3 text-sm font-bold text-sky-900">Resumo financeiro</h3>
                        <dl class="space-y-2 text-sm">
                            <div class="flex justify-between"><dt>Subtotal</dt><dd id="pr-sub" class="font-semibold"></dd></div>
                            <div class="flex items-center justify-between gap-2"><dt>ISS <input type="number" step="0.1" min="0" id="pr-iss" class="t-in !inline-block !w-20 !py-1" oninput="PR.set('iss',this.value)"> %</dt><dd id="pr-issv" class="font-semibold text-red-600"></dd></div>
                            <div class="flex items-center justify-between gap-2"><dt>Desconto <input type="number" step="0.1" min="0" id="pr-desc" class="t-in !inline-block !w-20 !py-1" oninput="PR.set('desc',this.value)"> %</dt><dd id="pr-descv" class="font-semibold text-red-600"></dd></div>
                        </dl>
                        <div class="mt-4 rounded-lg bg-sky-900 p-4 text-white"><div class="text-xs uppercase tracking-wide opacity-80">Total a pagar</div><div id="pr-total" class="text-3xl font-extrabold"></div></div>
                        <p class="mt-2 text-xs text-slate-400">Fórmula conforme a planilha: Total = Subtotal − ISS − Desconto, com Desconto = (Subtotal − taxa ISS) × % desconto.</p>
                        <button onclick="PR.exportar()" class="no-print mt-4 w-full rounded-xl bg-emerald-600 px-4 py-4 text-base font-extrabold text-white shadow-lg ring-4 ring-emerald-200 transition hover:bg-emerald-700 cursor-pointer">⬇ Exportar e salvar no computador</button>
                        <div class="no-print mt-3 grid grid-cols-2 gap-2">
                            <button class="t-b2" onclick="PR.csv()">CSV</button>
                            <button class="t-b2" onclick="window.print()">Imprimir / PDF</button>
                            <button class="t-b2" onclick="PR.salvar()">Salvar proposta</button>
                            <button class="t-b2" onclick="PR.chamado()">Gerar chamado</button>
                        </div>
                    </section>
                </aside>
            </div>
            <section class="t-card no-print mt-5">
                <div class="mb-3 flex gap-2" id="pr-tabs"></div>
                <div id="pr-lista" class="overflow-x-auto"></div>
            </section>
        </div>

        <!-- PAINEL: INDICADORES E DOCUMENTOS -->
        <div id="painel" class="page">
            <h2>Painel GTech · Indicadores, Financeiro, Estoque e Documentos</h2>
            <div class="mb-5 flex flex-wrap gap-2" id="pn-tabs"></div>
            <div id="pn-body"></div>
        </div>
        <div id="pr-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
            <form class="t-card w-full max-w-md" onsubmit="PR.okcad(event)"><h3 id="pr-mt" class="mb-4 text-lg font-bold text-sky-900"></h3><div id="pr-mf" class="space-y-3"></div>
                <div class="mt-5 flex justify-end gap-2"><button type="button" class="t-b2" onclick="PR.fecha()">Cancelar</button><button class="rounded-lg bg-sky-700 px-4 py-2 text-sm font-bold text-white hover:bg-sky-900 cursor-pointer">Salvar</button></div></form>
        </div>
        <div id="pr-toast" class="fixed bottom-5 right-5 z-50 hidden rounded-lg bg-slate-900 px-4 py-3 text-sm text-white shadow-lg"></div>

        <!-- FORMULARIO CONTRATAR SERVICO -->
        <div id="contratar" class="page">
            <h2>Cadastro de Solicitação de Serviço</h2>
            <form id="serviceForm" onsubmit="handleServiceSubmit(event)">
                <div class="form-group">
                    <label>Nome do Cliente / Empresa:</label>
                    <input type="text" id="cli_nome" required placeholder="Ex: Azevedo Soluções LTDA">
                </div>
                <div class="form-group">
                    <label>Endereço Completo:</label>
                    <input type="text" id="cli_end" required placeholder="Ex: Av. Dom Luís, 1200 - Aldeota, Fortaleza/CE">
                </div>
                <div class="form-group">
                    <label>Telefone / WhatsApp:</label>
                    <input type="tel" id="cli_tel" required placeholder="(85) 99999-9999">
                </div>
                <div class="form-group">
                    <label>Tipo de Serviço:</label>
                    <select id="cli_servico" required>
                        <option value="manutencao">Manutenção Remota</option>
                        <option value="troca">Troca de Equipamentos (Parque Reserva)</option>
                        <option value="duvidas">Dúvidas Operacionais / Suporte Geral</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Descrição Detalhada do Atendimento:</label>
                    <textarea id="cli_desc" rows="4" required placeholder="Descreva o problema ou necessidade..."></textarea>
                </div>
                <button type="submit" class="btn">Confirmar e Gerar Chamado</button>
            </form>
        </div>

        <!-- TELA DE LOGIN HELPDESK -->
        <div id="login" class="page">
            <h2>Acesso Restrito - Helpdesk N1</h2>
            <form onsubmit="handleLogin(event)" style="max-width: 400px;">
                <div class="form-group">
                    <label>Usuário:</label>
                    <input type="text" id="user" required value="administrador">
                </div>
                <div class="form-group">
                    <label>Senha:</label>
                    <input type="password" id="pass" required value="admnistradorti@123">
                </div>
                <button type="submit" class="btn">Entrar no Sistema ITIL</button>
            </form>
        </div>

        <!-- SISTEMA DE CHAMADOS (CLIENTE / PAINEL HELPDESK N1) -->
        <div id="chamados" class="page">
            <h2>Sistema de Chamados & Acompanhamento SLA (ITIL)</h2>
            <p style="margin-bottom: 1rem; font-size: 0.9rem; color: #666;">Painel Operacional N1 - Gestão do Ciclo de Vida do Chamado</p>

            <table>
                <thead>
                    <tr>
                        <th>ID Chamado</th>
                        <th>Cliente</th>
                        <th>Tipo de Chamado</th>
                        <th>SLA Máximo</th>
                        <th>Status ITIL</th>
                        <th>Ações N1</th>
                    </tr>
                </thead>
                <tbody id="chamadosTableBody">
                    <tr>
                        <td>#CH-1001</td>
                        <td>Clínica Saúde Aldeota</td>
                        <td>Troca de Equipamentos</td>
                        <td>2 Horas</td>
                        <td><span class="badge status-aberto">Aberto</span></td>
                        <td>
                            <button class="btn" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;" onclick="alterarStatus(this, 'Em Atendimento')">Atender</button>
                        </td>
                    </tr>
                    <tr>
                        <td>#CH-1002</td>
                        <td>Azevedo & Siqueira Adv</td>
                        <td>Manutenção Remota</td>
                        <td>6 Horas</td>
                        <td><span class="badge status-atendimento">Em Atendimento</span></td>
                        <td>
                            <button class="btn" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; background:#DC3545;" onclick="alterarStatus(this, 'Encerrado')">Encerrar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

    <footer>
        <p>&copy; 2026 GTech Soluções Tecnológicas. Todos os direitos reservados. Fortaleza/CE.</p>
    </footer>

    <script>
        let ticketCount = 1003;

        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            document.getElementById(pageId).classList.add('active');
        }

        function handleServiceSubmit(e) {
            e.preventDefault();
            const cliente = document.getElementById('cli_nome').value;
            const servico = document.getElementById('cli_servico').options[document.getElementById('cli_servico').selectedIndex].text;
            
            let sla = "24 Horas";
            if(document.getElementById('cli_servico').value === 'troca') sla = "2 Horas";
            if(document.getElementById('cli_servico').value === 'manutencao') sla = "6 Horas";

            const tbody = document.getElementById('chamadosTableBody');
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>#CH-${ticketCount++}</td>
                <td>${cliente}</td>
                <td>${servico}</td>
                <td>${sla}</td>
                <td><span class="badge status-aberto">Aberto</span></td>
                <td>
                    <button class="btn" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;" onclick="alterarStatus(this, 'Em Atendimento')">Atender</button>
                </td>
            `;
            tbody.appendChild(row);

            alert("Solicitação cadastrada com sucesso! Redirecionando para o Sistema de Chamados.");
            showPage('chamados');
        }

        function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('user').value;
            const p = document.getElementById('pass').value;

            if (u === 'administrador' && p === 'admnistradorti@123') {
                alert('Autenticado com sucesso como Helpdesk N1!');
                showPage('chamados');
            } else {
                alert('Usuário ou senha inválidos!');
            }
        }

        function alterarStatus(btn, novoStatus) {
            const tdStatus = btn.parentElement.parentElement.children[4];
            const tdAcao = btn.parentElement;

            if (novoStatus === 'Em Atendimento') {
                tdStatus.innerHTML = '<span class="badge status-atendimento">Em Atendimento</span>';
                tdAcao.innerHTML = `<button class="btn" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; background:#DC3545;" onclick="alterarStatus(this, 'Encerrado')">Encerrar</button>`;
            } else if (novoStatus === 'Encerrado') {
                tdStatus.innerHTML = '<span class="badge status-encerrado">Encerrado</span>';
                tdAcao.innerHTML = `<span style="font-size:0.85rem; color:#666;">Concluído</span>`;
            }
        }
    </script>
<script>
/* ===== GTech · Proposta de Vendas e Painel ===== */
const SEED={"clientes": [{"cod": 2, "cad": "2019-01-02", "nome": "Ana Silva Santos", "cpf": "123.456.789-01", "nasc": "1978-05-01", "whats": "(11) 98765-4321", "end": "Av. Paulista, 1000", "bairro": "Bela Vista", "cidade": "São Paulo", "uf": "SP"}, {"cod": 3, "cad": "2010-01-05", "nome": "Bruno Oliveira Lima", "cpf": "234.567.890-12", "nasc": "1979-05-02", "whats": "(21) 99876-5432", "end": "Rua Barão da Torre, 250", "bairro": "Ipanema", "cidade": "Rio de Janeiro", "uf": "RJ"}, {"cod": 4, "cad": "2015-01-10", "nome": "Carla Souza Pereira", "cpf": "345.678.901-23", "nasc": "1980-05-02", "whats": "(31) 97654-3210", "end": "Av. Afonso Pena, 1500", "bairro": "Centro", "cidade": "Belo Horizonte", "uf": "MG"}, {"cod": 5, "cad": "2005-01-12", "nome": "Daniel Costa Ferreira", "cpf": "456.789.012-34", "nasc": "1981-05-03", "whats": "(41) 98877-6655", "end": "Rua das Flores, 45", "bairro": "Batel", "cidade": "Curitiba", "uf": "PR"}, {"cod": 6, "cad": "2026-01-15", "nome": "Eduardo Rodrigues Alves", "cpf": "567.890.123-45", "nasc": "1982-05-04", "whats": "(51) 99123-4567", "end": "Av. Borges de Medeiros, 800", "bairro": "Praia de Belas", "cidade": "Porto Alegre", "uf": "RS"}, {"cod": 7, "cad": "2026-01-18", "nome": "Fernanda Lima Barbosa", "cpf": "678.901.234-56", "nasc": "1983-05-05", "whats": "(71) 98234-5678", "end": "Av. Oceanica, 300", "bairro": "Barra", "cidade": "Salvador", "uf": "BA"}, {"cod": 8, "cad": "2026-01-22", "nome": "Gabriel Martins Ribeiro", "cpf": "789.012.345-67", "nasc": "1984-05-05", "whats": "(85) 99345-6789", "end": "Av. Beira Mar, 2100", "bairro": "Meireles", "cidade": "Fortaleza", "uf": "CE"}, {"cod": 9, "cad": "2026-01-25", "nome": "Helena Castro Gomes", "cpf": "890.123.456-78", "nasc": "1985-05-06", "whats": "(81) 98456-7890", "end": "Av. Boa Viagem, 1200", "bairro": "Boa Viagem", "cidade": "Recife", "uf": "PE"}, {"cod": 10, "cad": "2026-01-28", "nome": "Igor Fernandes Rocha", "cpf": "901.234.567-89", "nasc": "1986-05-07", "whats": "(61) 99567-8901"